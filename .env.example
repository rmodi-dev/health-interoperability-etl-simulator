# =============================================================================
# TEMPLATE ONLY. Copy to .env and replace every CHANGE_ME value.
#   cp .env.example .env && chmod 600 .env
#   openssl rand -hex 16   # POSTGRES_PASSWORD
#   openssl rand -hex 32   # API_KEY
# .env is gitignored. Never commit real values.
# =============================================================================

# --- Runtime ---
APP_ENV=local
LOG_LEVEL=INFO
# Containers/PostgreSQL run in UTC even though the VM host is Africa/Kampala.
# Store UTC, display local. Unambiguous timestamps across HL7/FHIR/SQL.
TZ=UTC

# --- PostgreSQL (host port bound to loopback only; reached via Tailscale) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=interop
POSTGRES_USER=interop
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# --- FastAPI (active from Stage 7) ---
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=CHANGE_ME_openssl_rand_hex_32

# --- HL7 v2 MLLP listener (active from Stage 3) ---
MLLP_HOST=127.0.0.1
MLLP_PORT=2575

# --- LIS2-A2 instrument gateway, Node.js (active from Stage 4) ---
LIS2A2_HOST=127.0.0.1
LIS2A2_PORT=3000